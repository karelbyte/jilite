# Configuración de entorno para Railway (ejemplo)
# Copiar a variables reales en el panel de Railway, nunca subir secrets reales.

# Next.js / Auth.js
NEXTAUTH_URL=https://TU-APP.up.railway.app
NEXTAUTH_SECRET=REEMPLAZA_CON_UN_SECRETO_DE_32_BYTES_BASE64

# Base de datos (PostgreSQL gestionado por Railway)
DATABASE_URL=postgresql://railway:TU_PASSWORD@containers-us-west-1.railway.app:5432/railway

# Email (Resend)
RESEND_API_KEY=re_XXXXXXX
RESEND_FROM=Jilite <onboarding@resend.dev>

# App
NEXT_PUBLIC_APP_URL=https://TU-APP.up.railway.app

# Uploads — volumen debe montar en /app/public/uploads
UPLOAD_DIR=/app/public/uploads
UPLOAD_URL=/uploads

# Cron job secret (generado con: openssl rand -hex 16)
CRON_SECRET=genera-un-valor-secreto-unico-aqui

# Webhooks (opcional) - Slack / Discord / Teams
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Super admin inicial (seed prod, solo se crea si no existe ningún ADMIN)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=contraseña-segura-min-8
ADMIN_NAME=Admin
