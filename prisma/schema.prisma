generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROJECT_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id                       String          @id @default(cuid())
  name                     String
  email                    String          @unique
  password                 String
  image                    String?
  role                     Role            @default(USER)
  status                   UserStatus      @default(INACTIVE)
  createdById              String?
  verificationToken        String?         @unique
  verificationTokenExpires DateTime?
  emailVerifiedAt          DateTime?
  resetToken               String?         @unique
  resetTokenExpires        DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  tasks                    Task[]          @relation("Assignee")
  created                  Task[]          @relation("Creator")
  comments                 Comment[]
  files                    File[]
  projects                 Project[]       @relation("ProjectCreator")
  memberships              ProjectMember[]
  activities               ActivityLog[]
  savedViews               SavedView[]
  notifications            Notification[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdById String
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  labels      Label[]
  invitations Invitation[]
  savedViews  SavedView[]
  files       File[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([createdById])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Invitation {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  role      Role?
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([email])
  @@index([token])
}

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId, projectId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Task {
  id             String      @id @default(cuid())
  title          String
  description    String?
  status         Status      @default(TODO)
  priority       Priority    @default(MEDIUM)
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?       @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User        @relation("Creator", fields: [createdById], references: [id], onDelete: Cascade)
  dueDate        DateTime?
  reminderSentAt DateTime?
  recurrence     Recurrence?
  lastRecurredAt DateTime?
  position       Int         @default(0)
  subtasks       Subtask[]
  files          File[]
  comments       Comment[]
  labels         TaskLabel[]
  notifications  Notification[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([projectId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model File {
  id           String   @id @default(cuid())
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  filename     String   @unique
  contentType  String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  detail    String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityId])
}

model Outbox {
  id          String   @id @default(cuid())
  kind        String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  lastError   String?
  availableAt DateTime @default(now())
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([status, availableAt])
}

model Label {
  id        String      @id @default(cuid())
  name      String
  color     String
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]
  createdAt DateTime    @default(now())

  @@index([projectId])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Subtask {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title           String
  done            Boolean   @default(false)
  dueDate         DateTime?
  estimateMinutes Int?
  position        Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([taskId])
}
